# Models tried in order (LiteLLM model strings). Leave empty to use keyword rules only.
TRIAGE_MODELS=gemini/gemini-2.0-flash,openai/gpt-4o-mini
TRIAGE_LLM_TIMEOUT=10
TRIAGE_MAX_CONCURRENCY=5

# Provider keys -- only the ones for models listed above are needed.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse (optional). Without these, spans are created but not exported.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
